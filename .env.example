# Copy to .env and fill in. Never commit real keys.

# Provider: "groq" (recommended), "openai" (real), or "fake" (offline smoke test).
LLM_PROVIDER=groq

# --- Groq (LLM_PROVIDER=groq) ---
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=gsk_...
CHAT_MODEL=llama-3.1-8b-instant
# Embeddings are handled locally via sentence-transformers (no key needed).
EMBED_MODEL=all-MiniLM-L6-v2

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Retrieval / chunking knobs (experiment runner overrides these)
TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=120
PROMPT_VARIANT=grounded_v1
CHROMA_COLLECTION=northwind_support

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Tier A gate
FAITHFULNESS_FLOOR=0.90
